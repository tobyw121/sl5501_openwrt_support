--- a/arch/mips/cpu/mips32/lantiq-common/spl.c
+++ b/arch/mips/cpu/mips32/lantiq-common/spl.c
@@ -253,6 +253,36 @@
 	return ret;
 }
 
+static int spl_check_spi_source(struct spi_flash *sf,
+				const struct spl_image *spl)
+{
+	u8 buf[256];
+	ulong offset = spl->data_addr;
+	ulong left = spl->data_size;
+	ulong crc = 0;
+	int ret;
+
+	while (left) {
+		ulong len = left > sizeof(buf) ? sizeof(buf) : left;
+
+		ret = spi_flash_read(sf, offset, len, buf);
+		if (ret) {
+			printf("SPL: SPI source read failed at %08lx (%d)\n",
+				offset, ret);
+			return ret;
+		}
+
+		crc = crc32(crc, buf, len);
+		offset += len;
+		left -= len;
+	}
+
+	printf("SPL: SPI source CRC %08lx (expected %08lx)\n",
+		crc, spl->data_crc);
+
+	return crc == spl->data_crc ? 0 : -1;
+}
+
 static int spl_load_spi_flash(struct spl_image *spl)
 {
 	struct spi_flash sf = { 0 };
@@ -290,6 +320,11 @@
 	if (ret)
 		return ret;
 
+	/* Verify the SPI payload independently in SRAM before DDR is used. */
+	ret = spl_check_spi_source(&sf, spl);
+	if (ret)
+		return ret;
+
 	if (spl_is_compressed(spl))
 		loadaddr = CONFIG_LOADADDR;
 	else
@@ -299,6 +334,10 @@
 
 	ret = spi_flash_read(&sf, spl->data_addr, spl->data_size,
 				(void *) loadaddr);
+	if (ret) {
+		printf("SPL: U-Boot payload read failed (%d)\n", ret);
+		return ret;
+	}
 
 	if (!spl_check_data(spl, loadaddr))
 		return -1;

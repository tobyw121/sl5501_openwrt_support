--- /dev/null
+++ b/board/sphairon/sl5501/sl5501.c
@@ -0,0 +1,133 @@
+/*
+ * Sphairon/Zyxel Speedlink 5501 board support.
+ * Based on the GPLv2+ Sphairon SL550x board code.
+ * SPDX-License-Identifier: GPL-2.0+
+ */
+
+#include <common.h>
+#include <spi.h>
+#include <asm/gpio.h>
+#include <asm/lantiq/eth.h>
+#include <asm/lantiq/chipid.h>
+#include <asm/lantiq/cpu.h>
+#include <asm/arch/gphy.h>
+
+#if defined(CONFIG_SPL_BUILD)
+#define do_gpio_init 1
+#define do_pll_init  1
+#define do_dcdc_init 0
+#elif defined(CONFIG_SYS_BOOT_RAM)
+#define do_gpio_init 1
+#define do_pll_init  0
+#define do_dcdc_init 1
+#else
+#define do_gpio_init 0
+#define do_pll_init  0
+#define do_dcdc_init 1
+#endif
+
+static void gpio_init(void)
+{
+	/* Buttons, all low-active. */
+	gpio_direction_input(45); /* WLAN */
+	gpio_direction_input(46); /* WPS */
+	gpio_direction_input(47); /* reset */
+
+	/* Front LEDs. */
+	gpio_direction_output(3, 1);  /* power green, low-active */
+	gpio_direction_output(19, 1); /* power red */
+	gpio_direction_output(20, 1); /* info green */
+	gpio_direction_output(21, 1); /* info red */
+	gpio_direction_output(27, 1); /* internet green */
+	gpio_direction_output(28, 1); /* internet red */
+	gpio_direction_output(29, 1); /* WLAN green */
+	gpio_direction_output(30, 1); /* WPS green */
+	gpio_direction_output(32, 1); /* USB2 green */
+
+	/* SPI CS 0.4 for the S25FL512S. */
+	gpio_direction_output(10, 1);
+
+	/* USB power remains off while U-Boot runs. */
+	gpio_direction_output(41, 0);
+	gpio_direction_output(33, 0);
+
+	/* RT3662/RT5392 iNIC: reset asserted, power disabled. */
+	gpio_direction_output(15, 0);
+	gpio_direction_output(37, 0);
+}
+
+int board_early_init_f(void)
+{
+	if (do_gpio_init)
+		gpio_init();
+
+	if (do_pll_init)
+		ltq_pll_init();
+
+	if (do_dcdc_init)
+		ltq_dcdc_init(0x7f);
+
+	return 0;
+}
+
+int checkboard(void)
+{
+	puts("Board: " CONFIG_BOARD_NAME "\n");
+	ltq_chip_print_info();
+	return 0;
+}
+
+static const struct ltq_eth_port_config eth_port_config[] = {
+	/* GMAC0: external PEF7071, WANoE. */
+	{ 0, 0x00, LTQ_ETH_PORT_PHY,  PHY_INTERFACE_MODE_RGMII },
+	/* GMAC1: external PEF7071, LAN4. */
+	{ 1, 0x01, LTQ_ETH_PORT_PHY,  PHY_INTERFACE_MODE_RGMII },
+	/* GMAC2: internal FE GPHY, LAN1. */
+	{ 2, 0x11, LTQ_ETH_PORT_PHY,  PHY_INTERFACE_MODE_MII },
+	/* GMAC3: internal FE GPHY, LAN2. */
+	{ 3, 0x12, LTQ_ETH_PORT_PHY,  PHY_INTERFACE_MODE_MII },
+	/* GMAC4: internal GE GPHY, LAN3. */
+	{ 4, 0x13, LTQ_ETH_PORT_PHY,  PHY_INTERFACE_MODE_GMII },
+	/* GMAC5 is the Ralink iNIC datapath; Linux owns it. */
+	{ 5, 0x00, LTQ_ETH_PORT_NONE, PHY_INTERFACE_MODE_NONE },
+};
+
+static const struct ltq_eth_board_config eth_board_config = {
+	.ports = eth_port_config,
+	.num_ports = ARRAY_SIZE(eth_port_config),
+};
+
+int board_eth_init(bd_t *bis)
+{
+	const enum ltq_gphy_clk clk = LTQ_GPHY_CLK_25MHZ_PLL0;
+	const ulong fw_ge_addr = 0x80fe0000;
+	const ulong fw_fe_addr = 0x80ff0000;
+
+	/* Exact SL5501 vendor arrangement: GPHY0 FE, GPHY1 GE. */
+	ltq_gphy_phy11g_a2x_load(fw_ge_addr);
+	ltq_gphy_phy22f_a2x_load(fw_fe_addr);
+
+	ltq_cgu_gphy_clk_src(clk);
+	ltq_rcu_gphy_boot(0, fw_fe_addr);
+	ltq_rcu_gphy_boot(1, fw_ge_addr);
+
+	return ltq_eth_initialize(&eth_board_config);
+}
+
+int spi_cs_is_valid(unsigned int bus, unsigned int cs)
+{
+	return bus == 0 && cs == 4;
+}
+
+void spi_cs_activate(struct spi_slave *slave)
+{
+	if (slave->bus == 0 && slave->cs == 4)
+		gpio_set_value(10, 0);
+}
+
+void spi_cs_deactivate(struct spi_slave *slave)
+{
+	if (slave->bus == 0 && slave->cs == 4)
+		gpio_set_value(10, 1);
+}
+

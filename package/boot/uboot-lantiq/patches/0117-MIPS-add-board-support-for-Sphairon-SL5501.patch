diff --git a/include/configs/sl5501.h b/include/configs/sl5501.h
new file mode 100644
index 0000000..bcf5edc
--- /dev/null
+++ b/include/configs/sl5501.h
@@ -0,0 +1,95 @@
+/*
+ * Sphairon/Zyxel Speedlink 5501 configuration.
+ * Based on the GPLv2+ Sphairon SL550x configuration.
+ * SPDX-License-Identifier: GPL-2.0+
+ */
+
+#ifndef __CONFIG_SL5501_H
+#define __CONFIG_SL5501_H
+
+#define CONFIG_MACH_TYPE        "SPHSL550X"
+#define CONFIG_IDENT_STRING     " " CONFIG_MACH_TYPE
+#define CONFIG_BOARD_NAME       "Sphairon/Zyxel Speedlink 5501"
+
+#define CONFIG_LTQ_SUPPORT_UART
+#define CONFIG_LTQ_SUPPORT_ETHERNET
+
+#define CONFIG_LTQ_SSIO_SHIFT_REGS 1
+#define CONFIG_LTQ_SSIO_EDGE_FALLING
+#define CONFIG_LTQ_SSIO_GPHY1_MODE 0x3
+#define CONFIG_LTQ_SSIO_GPHY2_MODE 0x3
+#define CONFIG_LTQ_SSIO_INIT_VALUE 0x0
+
+#define CONFIG_LTQ_SUPPORT_SPI_FLASH
+#define CONFIG_SPI_FLASH_SPANSION
+
+#define CONFIG_LTQ_SUPPORT_SPL_SPI_FLASH
+#define CONFIG_SPL_SPI_BUS      0
+#define CONFIG_SPL_SPI_CS       4
+#define CONFIG_SPL_SPI_MAX_HZ   25000000
+#define CONFIG_SPL_SPI_MODE     0
+#define CONFIG_LTQ_SPL_COMP_LZO
+#define CONFIG_LTQ_SPL_CONSOLE
+
+/* Keep the vendor DDR controller geometry untouched in SPL. */
+/* CONFIG_SYS_DRAM_PROBE intentionally disabled for SL5501. */
+
+/* Allow a generously sized OpenWrt kernel to be decompressed. */
+#define CONFIG_SYS_BOOTM_LEN    0x01000000
+
+/* Authoritative NTLB layout for this port. Linux also has it in the DTS. */
+#define MTDIDS_DEFAULT "nor0=spi0.4"
+#define MTDPARTS_DEFAULT \
+	"mtdparts=spi0.4:512k(uboot_fix),256k(uboot_cfg)," \
+	"15872k(firmware),-(data)"
+
+/* Environment is the complete 256 KiB uboot_cfg erase sector. */
+#define CONFIG_ENV_SPI_BUS      CONFIG_SPL_SPI_BUS
+#define CONFIG_ENV_SPI_CS       CONFIG_SPL_SPI_CS
+#define CONFIG_ENV_SPI_MAX_HZ   CONFIG_SPL_SPI_MAX_HZ
+#define CONFIG_ENV_SPI_MODE     CONFIG_SPL_SPI_MODE
+
+#if defined(CONFIG_SYS_BOOT_SFSPL)
+#define CONFIG_ENV_IS_IN_SPI_FLASH
+#define CONFIG_ENV_OVERWRITE
+#define CONFIG_ENV_OFFSET       0x00080000
+#define CONFIG_ENV_SECT_SIZE    0x00040000
+#else
+#define CONFIG_ENV_IS_NOWHERE
+#endif
+#define CONFIG_ENV_SIZE         0x00002000
+
+#define CONFIG_LOADADDR         CONFIG_SYS_LOAD_ADDR
+
+#define CONFIG_LTQ_ADVANCED_CONSOLE
+#define CONFIG_BAUDRATE         115200
+#define CONFIG_CONSOLE_ASC      1
+#define CONFIG_CONSOLE_DEV      "ttyLTQ1"
+
+#include <asm/lantiq/config.h>
+#include <asm/arch/config.h>
+#include "openwrt-lantiq-common.h"
+
+/* Device-specific fallback. The valid uboot_cfg image uses the same value. */
+#undef CONFIG_ETHADDR
+#define CONFIG_ETHADDR          1C:74:0D:BA:28:10
+
+/*
+ * The SPI NOR is not memory mapped. Read the complete 15.5 MiB firmware
+ * partition to a high RAM address for bootm. 0x82000000 avoids overlap with
+ * the kernel decompression destination near 0x80000000.
+ */
+#undef CONFIG_BOOTCOMMAND
+#define CONFIG_BOOTCOMMAND "run boot_openwrt"
+
+#define CONFIG_EXTRA_ENV_SETTINGS \
+	CONFIG_ENV_LANTIQ_DEFAULTS \
+	"openwrt_addr=0x82000000\0" \
+	"boot_openwrt=setenv bootargs console=ttyLTQ0,115200 ethaddr=${ethaddr}; " \
+		"sf probe 0:4 25000000 0; " \
+		"sf read ${openwrt_addr} 0x000c0000 0x00f80000; " \
+		"bootm ${openwrt_addr}\0" \
+	"mtdids=" MTDIDS_DEFAULT "\0" \
+	"mtdparts=" MTDPARTS_DEFAULT "\0"
+
+#endif /* __CONFIG_SL5501_H */

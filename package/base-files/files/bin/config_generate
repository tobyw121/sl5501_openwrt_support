#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# OpenWrt 24.10 compatible first-boot configuration generator.
#
# This SL5501-only tree accidentally lost the upstream config_generate helper.
# /etc/init.d/boot invokes this before netifd starts; without it, network and
# system UCI are never generated and `ubus call network reload` returns NOT_FOUND.

CFG=/etc/board.json

. /usr/share/libubox/jshn.sh

[ -s "$CFG" ] || /bin/board_detect || exit 1
[ -s /etc/config/network ] && [ -s /etc/config/system ] && exit 0

generate_static_network() {
	uci -q batch <<-EOF_UCI
		delete network.loopback
		set network.loopback='interface'
		set network.loopback.device='lo'
		set network.loopback.proto='static'
		set network.loopback.ipaddr='127.0.0.1'
		set network.loopback.netmask='255.0.0.0'
		delete network.globals
		set network.globals='globals'
		set network.globals.ula_prefix='auto'
EOF_UCI

	# Preserve the Lantiq DSL defaults exported by the board scripts.
	if json_is_a dsl object; then
		json_select dsl
		if json_is_a atmbridge object; then
			json_select atmbridge
			local vpi vci encaps payload nameprefix
			json_get_vars vpi vci encaps payload nameprefix
			uci -q batch <<-EOF_UCI
				delete network.atm
				set network.atm='atm-bridge'
				set network.atm.vpi='$vpi'
				set network.atm.vci='$vci'
				set network.atm.encaps='$encaps'
				set network.atm.payload='$payload'
				set network.atm.nameprefix='$nameprefix'
EOF_UCI
			json_select ..
		fi
		if json_is_a modem object; then
			json_select modem
			local annex firmware tone xfer_mode
			json_get_vars annex firmware tone xfer_mode
			uci -q batch <<-EOF_UCI
				delete network.dsl
				set network.dsl='dsl'
				set network.dsl.annex='$annex'
				set network.dsl.firmware='$firmware'
				set network.dsl.tone='$tone'
				set network.dsl.xfer_mode='$xfer_mode'
EOF_UCI
			json_select ..
		fi
		json_select ..
	fi
}

generate_network() {
	local name="$1"
	local ports device macaddr protocol metric
	local uci_dev="${name}_dev"

	json_select network || return
	json_select "$name" || { json_select ..; return; }
	json_get_vars device macaddr protocol metric
	json_get_values ports ports
	json_select ..
	json_select ..

	[ -n "$device" ] || [ -n "$ports" ] || return

	if [ -n "$ports" ]; then
		device="br-$name"
		uci -q batch <<-EOF_UCI
			delete network.$uci_dev
			set network.$uci_dev='device'
			set network.$uci_dev.name='$device'
			set network.$uci_dev.type='bridge'
EOF_UCI
		for port in $ports; do
			uci -q add_list "network.$uci_dev.ports=$port"
		done
		[ -n "$macaddr" ] && uci -q set "network.$uci_dev.macaddr=$macaddr"
	elif [ -n "$macaddr" ]; then
		uci -q batch <<-EOF_UCI
			delete network.$uci_dev
			set network.$uci_dev='device'
			set network.$uci_dev.name='$device'
			set network.$uci_dev.macaddr='$macaddr'
EOF_UCI
	fi

	uci -q batch <<-EOF_UCI
		delete network.$name
		set network.$name='interface'
		set network.$name.device='$device'
		set network.$name.metric='$metric'
		set network.$name.proto='none'
EOF_UCI

	case "$protocol" in
		static)
			local ipaddr netmask
			[ "$name" = lan ] && ipaddr='192.168.1.1' || ipaddr='192.168.2.1'
			netmask='255.255.255.0'
			uci -q batch <<-EOF_UCI
				set network.$name.proto='static'
				set network.$name.ipaddr='$ipaddr'
				set network.$name.netmask='$netmask'
				set network.$name.ip6assign='60'
EOF_UCI
			;;
		dhcp)
			uci -q set "network.$name.proto=dhcp"
			if [ -e /proc/sys/net/ipv6 ]; then
				uci -q batch <<-EOF_UCI
					delete network.${name}6
					set network.${name}6='interface'
					set network.${name}6.device='$device'
					set network.${name}6.proto='dhcpv6'
EOF_UCI
			fi
			;;
		pppoe)
			uci -q batch <<-EOF_UCI
				set network.$name.proto='pppoe'
				set network.$name.username='username'
				set network.$name.password='password'
EOF_UCI
			;;
	esac
}

generate_system() {
	local hostname='OpenWrt'
	local timezone='UTC'
	local compat_version='1.0'

	if json_is_a system object; then
		json_select system
		json_get_vars hostname timezone compat_version
		json_select ..
		[ -n "$hostname" ] || hostname='OpenWrt'
		[ -n "$timezone" ] || timezone='UTC'
		[ -n "$compat_version" ] || compat_version='1.0'
	fi

	uci -q batch <<-EOF_UCI
		delete system.@system[0]
		add system system
		set system.@system[-1].hostname='$hostname'
		set system.@system[-1].timezone='$timezone'
		set system.@system[-1].ttylogin='0'
		set system.@system[-1].log_size='128'
		set system.@system[-1].urandom_seed='0'
		set system.@system[-1].compat_version='$compat_version'
		delete system.ntp
		set system.ntp='timeserver'
		set system.ntp.enabled='1'
		set system.ntp.enable_server='0'
		add_list system.ntp.server='0.openwrt.pool.ntp.org'
		add_list system.ntp.server='1.openwrt.pool.ntp.org'
		add_list system.ntp.server='2.openwrt.pool.ntp.org'
		add_list system.ntp.server='3.openwrt.pool.ntp.org'
EOF_UCI
}

json_init
json_load "$(cat "$CFG")" || exit 1
umask 077

if [ ! -s /etc/config/network ]; then
	mkdir -p /etc/config
	: > /etc/config/network
	generate_static_network
	generate_network lan
	generate_network wan
fi

if [ ! -s /etc/config/system ]; then
	mkdir -p /etc/config
	: > /etc/config/system
	generate_system
fi

uci commit network
uci commit system
exit 0

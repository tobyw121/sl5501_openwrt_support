# Fallback only. The ieee80211 hotplug worker normally owns first bring-up;
# v16's common worker skips this invocation once wireless is requested/ready.
START=99
STOP=10

start() {
	/usr/sbin/sl5501-wifi-autostart init >/dev/null 2>&1 &
}
